{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherstream.io/schemas/glorious-pipeline.schema.json",
  "title": "Glorious live truck pipeline",
  "$comment": "Graph constraints and upstream field availability are checked by PipelineValidator. Projection retains truckId; average exposes its numeric field and optional groupBy field, but no eventTime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "nodes", "edges"],
  "properties": {
    "name": {"$ref": "#/$defs/name"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "field": {"enum": ["truckId", "speedKmh", "heading", "x", "y", "routeId", "status", "partition", "eventTime"]},
    "numericField": {"enum": ["speedKmh", "heading", "x", "y", "partition", "eventTime"]},
    "comparison": {
      "oneOf": [
        {"properties": {"field": {"$ref": "#/$defs/numericField"}, "op": {"enum": [">", ">=", "<", "<=", "==", "!="]}, "value": {"type": "number"}}},
        {"properties": {"field": {"enum": ["truckId", "routeId", "status"]}, "op": {"enum": ["==", "!="]}, "value": {"type": "string"}}}
      ]
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "params"],
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string"}, "params": {"type": "object"}},
      "oneOf": [
        {"properties": {"type": {"const": "filter"}, "params": {"type": "object", "additionalProperties": false, "required": ["field", "op", "value"], "properties": {"field": {"$ref": "#/$defs/field"}, "op": {"type": "string"}, "value": {}}, "allOf": [{"$ref": "#/$defs/comparison"}]}}},
        {"properties": {"type": {"const": "thresholdAlert"}, "params": {"type": "object", "additionalProperties": false, "required": ["field", "op", "value", "message"], "properties": {"field": {"$ref": "#/$defs/field"}, "op": {"type": "string"}, "value": {}, "message": {"type": "string", "minLength": 1, "maxLength": 120}}, "allOf": [{"$ref": "#/$defs/comparison"}]}}},
        {"properties": {"type": {"const": "pickFields"}, "params": {"type": "object", "additionalProperties": false, "required": ["fields"], "properties": {"fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/field"}}}}}},
        {"properties": {"type": {"const": "windowAverage"}, "params": {"type": "object", "additionalProperties": false, "required": ["field", "windowSec"], "properties": {"field": {"$ref": "#/$defs/numericField"}, "windowSec": {"type": "integer", "minimum": 5, "maximum": 300}, "groupBy": {"enum": ["truckId", "routeId", "status", "partition"]}}}}},
        {"properties": {"type": {"const": "output"}, "params": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/$defs/name"}}}}}
      ]
    }
  }
}
