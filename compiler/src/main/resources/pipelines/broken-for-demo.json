{
  "id": "broken-for-demo",
  "version": 1,
  "name": "Broken logistics demo",
  "nodes": [
    { "id": "src", "type": "source", "label": "Truck events", "position": {"x": 0, "y": 0}, "config": { "topic": "truck-events", "startFrom": "latest" } },
    { "id": "pos", "type": "filter", "label": "Position events", "position": {"x": 220, "y": 0}, "config": { "conditions": [{"field": "type", "op": "==", "value": "truck.position"}] } },
    { "id": "speed1m", "type": "window", "label": "1-minute speed window", "position": {"x": 440, "y": 0}, "config": { "kind": "tumbling", "sizeMs": 60000, "outOfOrdernessMs": 5000, "aggregations": [{"name": "avgSpeedKmh", "fn": "avg", "field": "payload.speedKmh"}, {"name": "maxSpeedKmh", "fn": "max", "field": "payload.speedKmh"}, {"name": "count", "fn": "count"}] } },
    { "id": "speedSink", "type": "sink", "label": "Window results", "position": {"x": 660, "y": 100}, "config": { "kind": "postgres.windows" } },
    { "id": "stuck", "type": "rule", "label": "Stuck truck rule", "position": {"x": 660, "y": -100}, "config": { "ruleId": "stuck-truck", "condition": {"field": "avgSpeedKmh", "op": "<", "value": 1.0}, "forWindows": 10, "message": "{key} has not moved for {minutes} min" } },
    { "id": "alertSink", "type": "sink", "label": "Alert results", "position": {"x": 880, "y": -100}, "config": { "kind": "postgres.windows" } },
    { "id": "del", "type": "filter", "label": "Delivery events", "position": {"x": 220, "y": 220}, "config": { "conditions": [{"field": "type", "op": "==", "value": "truck.delivery"}] } }
  ],
  "edges": [
    {"from": "src", "to": "pos"}, {"from": "pos", "to": "speed1m"},
    {"from": "speed1m", "to": "speedSink"}, {"from": "speed1m", "to": "stuck"}, {"from": "stuck", "to": "alertSink"},
    {"from": "src", "to": "del"}
  ]
}
